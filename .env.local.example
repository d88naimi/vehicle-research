# Anthropic — required for the AI chat assistant
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# YouTube Data API v3 — for fetching real video reviews
# Get yours at https://console.cloud.google.com → APIs & Services → YouTube Data API v3
YOUTUBE_API_KEY=AIza...

# Tavily — for curating expert article results
# Get yours at https://app.tavily.com
TAVILY_API_KEY=tvly-...

# PDF/Slides export — optional, for server-side generation
# Puppeteer runs headless Chrome; no key needed, just install the package
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# Database — optional, for saving user research sessions
DATABASE_URL=postgresql://user:password@localhost:5432/vehicle_research
